# Built binary. Anchored: an unanchored `loupe` also matches cmd/loupe/.
/loupe
/uiprobe
/dist/

# Tailnet TLS material. The .key is a real EC private key.
*.crt
*.key

# Traces and run logs: machine-local output, regenerated every run.
loupe-trace*.jsonl
loupe-run.log

# Captured streams. The scrcpy-server jar under internal/scrcpy/server/ is
# committed deliberately -- it is embedded in the binary -- so only a stray
# bare `scrcpy-server` download is ignored here.
*.h264
/scrcpy-server

# Claude Code session scratch state.
.claude/state/

# Supervisor run copies of the binary.
.run/

# Brainstorming companion mockups
.superpowers/

# Build output, and the simcap download.
/.build/

# agent-team workspaces (created outside the repo; belt-and-braces).
.claude/workspaces/

# Generated by xcodegen from tools/xcrunner/project.yml (make xcrunner).
/tools/xcrunner/LoupeRunner.xcodeproj/
